{
  "name": "toss",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "next start",
    "test": "node --import tsx --test tests/*.test.mjs",
    "mobile:dev": "vite --config mobile/vite.config.mts",
    "mobile:build": "tsc --project mobile/tsconfig.json && vite build --config mobile/vite.config.mts",
    "mobile:preview": "vite preview --config mobile/vite.config.mts",
    "mobile:sync": "pnpm mobile:build && cap sync",
    "mobile:open:android": "cap open android",
    "mobile:open:ios": "cap open ios",
    "mobile:run:android": "pnpm mobile:build && cap run android",
    "mobile:run:ios": "pnpm mobile:build && cap run ios"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/barcode-scanner": "3.1.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/ios": "8.5.3",
    "@capacitor/share": "8.0.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-slot": "1.2.4",
    "@vercel/analytics": "2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.0.1",
    "next": "16.2.1",
    "next-themes": "^0.4.6",
    "peerjs": "1.5.5",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.7.3",
    "@capacitor/cli": "8.5.3",
    "@eslint-react/eslint-plugin": "^2.13.0",
    "@next/eslint-plugin-next": "^16.2.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.2",
    "baseline-browser-mapping": "^2.10.10",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.20.6",
    "tw-animate-css": "1.4.0",
    "typescript": "^5.9.3",
    "vite": "8.3.4"
  }
}
